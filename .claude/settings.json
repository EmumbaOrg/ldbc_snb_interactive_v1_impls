{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(java *)",
      "Bash(jar *)",
      "Bash(javap *)",
      "Bash(psql *)",
      "Bash(PGPASSWORD=postgres psql *)",
      "Bash(pg_isready *)",
      "Bash(python3 *)",
      "Bash(bash scripts/*.sh)",
      "Bash(bash driver/*.sh)",
      "Bash(CONNECTION_STRING=* bash scripts/*.sh)",
      "Bash(docker exec age-pg17-local *)",
      "Bash(docker restart age-pg17-local *)"
    ]
  }
}
